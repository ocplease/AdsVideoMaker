# Required in Vercel Project Settings > Environment Variables.
AD_VIDEO_BASE_URL=https://your-ad-video-api.example.com

# Required for user image uploads. Vercel creates this when a Blob Store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Optional metadata if your API setup uses it.
AD_VIDEO_CLIENT_ID=huawei

# Optional only for local execution behind a corporate proxy.
# Do not configure this on Vercel unless your deployed function requires it.
# HTTPS_PROXY=http://username:password@proxy.example.com:8080
# HTTP_PROXY=http://username:password@proxy.example.com:8080
